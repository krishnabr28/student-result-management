# Copy this file to .env and fill in your own values.

# MySQL connection. The user needs permission to create a database (root is fine on your own laptop).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=internship_result_db

# Long random text used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Web server. Use APP_HOST=0.0.0.0 to open the app from a phone on the same Wi-Fi.
APP_HOST=127.0.0.1
APP_PORT=5000

# Show one-click demo logins on the login page (only for the college demo).
SHOW_DEMO_ACCOUNTS=true
